# Docker-free local development. Copy this file to .env.local if you need overrides.
WISDOME_ENVIRONMENT=development
WISDOME_RUNTIME_MODE=local
DJANGO_SETTINGS_MODULE=wisdome_writer.settings
DJANGO_DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000

# These default to repository-local paths and normally do not need to be set.
# LOCAL_STATE_ROOT=.local/state
# LOCAL_ARTICLE_ROOT=output/housing
# LOCAL_OBJECT_ROOT=.local/objects
HUMANIZER_BASE_URL=http://127.0.0.1:3210
