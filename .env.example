# Local development is enabled only by this explicit mode selection.
# Production must use "production"; settings then reject missing, placeholder, local, or insecure values.
WISDOME_ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=wisdome_writer.settings
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Required Compose infrastructure credentials. Choose unique development-only values locally.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=ap-northeast-2
AWS_S3_ADDRESSING_STYLE=path
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300

# Use a dedicated value distinct from DJANGO_SECRET_KEY.
AUDIT_CURSOR_SIGNING_KEY=
REAUTH_PROOF_TTL_SECONDS=300
REAUTH_MFA_REQUIRED=false
# Required only when REAUTH_MFA_REQUIRED=true; dotted callable accepting (admin, code).
REAUTH_MFA_VALIDATOR=

# Publisher-only inputs. They are not passed to collection, extraction, OCR, or scheduler services.
BLOGGER_OAUTH_CLIENT_ID_REF=env://BLOGGER_OAUTH_CLIENT_ID
BLOGGER_OAUTH_CLIENT_SECRET_REF=env://BLOGGER_OAUTH_CLIENT_SECRET
BLOGGER_OAUTH_CLIENT_ID=
BLOGGER_OAUTH_CLIENT_SECRET=
BLOGGER_ACCESS_TOKEN=
# Dotted callable that writes OAuth token payloads to Vault/KMS and returns a credentialRef.
BLOGGER_OAUTH_TOKEN_STORE=
# JSON mapping from secret URI scheme to a no-argument provider class.
SECRET_PROVIDER_CLASSES={}

# OCR-only inputs are assigned by compose.yaml and never passed to the publishing worker.
PADDLEOCR_HOME=/models/paddleocr
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# The web service binds to loopback by default. Set a non-loopback address only behind an intended proxy.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT_SECONDS=60
TZ=Asia/Seoul
