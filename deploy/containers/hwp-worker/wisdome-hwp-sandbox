class SandboxInvalidInput(Exception):
    pass


class SandboxConverterFailure(Exception):
    pass


class SandboxResourceLimit(Exception):
    pass


class ProtocolViolation(Exception):
    pass


def is_sha256(value: object) -> bool:
    return (
        isinstance(value, str)
        and len(value) == 64
        and set(value) != {"0"}
        and all(character in "0123456789abcdef" for character in value)
    )


def positive_int(value: object, maximum: int) -> bool:
    return type(value) is int and 0 < value <= maximum


def strict_json(raw: bytes, *, fields: frozenset[str]) -> dict[str, Any]:
    def reject_constant(value: str) -> None:
        raise ProtocolViolation(f"non-finite JSON value: {value}")

    def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ProtocolViolation("duplicate JSON key")
            result[key] = value
        return result

    try:
        value = json.loads(
            raw.decode("utf-8"),
            parse_constant=reject_constant,
            object_pairs_hook=unique_object,
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ProtocolViolation("invalid JSON") from exc
    if not isinstance(value, dict) or set(value) != fields:
        raise ProtocolViolation("JSON object has missing or unknown fields")
    return value


def canonical_json(value: Mapping[str, Any]) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def validate_relative_input(value: str) -> str:
    if not isinstance(value, str):
        raise SandboxInvalidInput("input path is not text")
    path = PurePosixPath(value)
    if path.is_absolute() or len(path.parts) != 1 or path.as_posix() != value or not INPUT_BASENAME.fullmatch(value):
        raise SandboxInvalidInput("input path is not an approved basename")
    return value


def _stream_snapshot(
    source_descriptor: int,
    destination: Path,
    *,
    expected_size: int,
    expected_hash: str | None,
) -> tuple[str, int, bytes]:
    digest = hashlib.sha256()
    size = 0
    prefix = bytearray()
    destination_descriptor = os.open(
        destination,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0),
        0o400,
    )
    try:
        while True:
            chunk = os.read(source_descriptor, min(1024 * 1024, expected_size - size + 1))
            if not chunk:
                break
            size += len(chunk)
            if size > expected_size:
                raise SandboxInvalidInput("untrusted material exceeds its byte limit")
            if len(prefix) < 8:
                prefix.extend(chunk[: 8 - len(prefix)])
            digest.update(chunk)
            view = memoryview(chunk)
            while view:
                written = os.write(destination_descriptor, view)
                view = view[written:]
        os.fsync(destination_descriptor)
    except BaseException:
        destination.unlink(missing_ok=True)
        raise
    finally:
        os.close(destination_descriptor)
    observed_hash = digest.hexdigest()
    if size != expected_size or (expected_hash is not None and observed_hash != expected_hash):
        destination.unlink(missing_ok=True)
        raise SandboxInvalidInput("untrusted material differs from its declared identity")
    destination.chmod(0o400)
    return observed_hash, size, bytes(prefix)


def snapshot_verified_input(
    root: Path,
    relative_path: str,
    expected_size: int,
    expected_hash: str,
    destination: Path,
) -> tuple[str, int]:
    validate_relative_input(relative_path)
    if not positive_int(expected_size, 512 * 1024 * 1024) or not is_sha256(expected_hash):
        raise SandboxInvalidInput("input material fields are invalid")
    candidate = root / relative_path
    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(candidate, flags)
    except OSError as exc:
        raise SandboxInvalidInput("input cannot be opened safely") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size != expected_size
        ):
            raise SandboxInvalidInput("input is not a single-link regular file of the expected size")
        observed_hash, observed_size, _ = _stream_snapshot(
            descriptor,
            destination,
            expected_size=expected_size,
            expected_hash=expected_hash,
        )
        return observed_hash, observed_size
    finally:
        os.close(descriptor)


def open_verified_input(root: Path, relative_path: str, expected_size: int, expected_hash: str) -> tuple[str, int]:
    """Compatibility verifier that does not retain the complete input in memory."""
    with tempfile.TemporaryDirectory(prefix="hwp-input-verify-") as temporary_directory:
        return snapshot_verified_input(
            root,
            relative_path,
            expected_size,
            expected_hash,
            Path(temporary_directory) / "snapshot.hwp",
        )


def snapshot_untrusted_pdf(source: Path, destination: Path, max_output_bytes: int) -> dict[str, Any]:
    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(source, flags)
    except OSError as exc:
        raise SandboxConverterFailure("private PDF cannot be opened safely") from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or not positive_int(metadata.st_size, max_output_bytes)
        ):
            raise SandboxConverterFailure("private PDF is not a bounded single-link regular file")
        try:
            digest, size, prefix = _stream_snapshot(
                descriptor,
                destination,
                expected_size=metadata.st_size,
                expected_hash=None,
            )
        except SandboxInvalidInput as exc:
            raise SandboxConverterFailure("private PDF changed during snapshot") from exc
        if prefix[:5] != b"%PDF-":
            destination.unlink(missing_ok=True)
            raise SandboxConverterFailure("private output is not a PDF")
        return {"sha256": digest, "byte_size": size}
    finally:
        os.close(descriptor)


def run_snapshot_cli(arguments: argparse.Namespace) -> int:
    """Trusted post-conversion copier run as the untrusted UID with one supervisor-owned FD."""
    source = Path(arguments.source)
    maximum = int(arguments.max_output_bytes)
    destination_fd = int(arguments.destination_fd)
    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        if (
            not source.is_absolute()
            or source.name != "converted.pdf"
            or source.parent.resolve() != Path.cwd().resolve()
            or destination_fd < 3
        ):
            return 1
        source_fd = os.open(source, flags)
        try:
            metadata = os.fstat(source_fd)
            destination_metadata = os.fstat(destination_fd)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or not positive_int(metadata.st_size, maximum)
                or not stat.S_ISREG(destination_metadata.st_mode)
                or destination_metadata.st_nlink != 1
                or destination_metadata.st_size != 0
                or destination_metadata.st_uid == os.geteuid()
                or (metadata.st_dev, metadata.st_ino)
                == (destination_metadata.st_dev, destination_metadata.st_ino)
            ):
                return 1
            digest = hashlib.sha256()
            size = 0
            prefix = bytearray()
            while True:
                chunk = os.read(source_fd, min(1024 * 1024, metadata.st_size - size + 1))
                if not chunk:
                    break
                size += len(chunk)
                if size > metadata.st_size:
                    return 1
                if len(prefix) < 5:
                    prefix.extend(chunk[: 5 - len(prefix)])
                digest.update(chunk)
                view = memoryview(chunk)
                while view:
                    written = os.write(destination_fd, view)
                    view = view[written:]
            os.fsync(destination_fd)
            if size != metadata.st_size or bytes(prefix) != b"%PDF-":
                return 1
            sys.stdout.buffer.write(canonical_json({
                "sha256": digest.hexdigest(),
                "byte_size": size,
                "pdf_mime": "application/pdf",
            }))
            sys.stdout.buffer.flush()
            return 0
        finally:
            os.close(source_fd)
    except (OSError, ValueError):
        return 1


def snapshot_via_identity(
    source: Path,
    destination: Path,
    *,
    wrapper_path: Path,
    workspace: Path,
    environment: Mapping[str, str],
    timeout_seconds: int,
    limits: Mapping[str, int],
    max_output_bytes: int,
    uid: int,
    gid: int,
) -> dict[str, Any]:
    destination_fd = os.open(
        destination,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0),
        0o400,
    )
    try:
        return_code, stdout, stderr = _run_bounded(
            [
                str(wrapper_path),
                "snapshot",
                "--source",
                str(source),
                "--destination-fd",
                str(destination_fd),
                "--max-output-bytes",
                str(max_output_bytes),
            ],
            cwd=workspace,
            environment=environment,
            timeout_seconds=timeout_seconds,
            limits=limits,
            process_group=True,
            uid=uid,
            gid=gid,
            pass_fds=(destination_fd,),
        )
    finally:
        os.close(destination_fd)
    if return_code != 0 or stderr:
        destination.unlink(missing_ok=True)
        raise SandboxConverterFailure("trusted streaming snapshot helper failed")
    snapshot = strict_json(stdout, fields=frozenset({"sha256", "byte_size", "pdf_mime"}))
    metadata = destination.lstat()
    if (
        destination.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or metadata.st_size != snapshot.get("byte_size")
        or not is_sha256(snapshot.get("sha256"))
        or sha256_file(destination) != snapshot.get("sha256")
        or snapshot.get("pdf_mime") != "application/pdf"
    ):
        destination.unlink(missing_ok=True)
        raise SandboxConverterFailure("trusted streaming snapshot identity is invalid")
    destination.chmod(0o400)
    return snapshot


def verify_manifest(path: Path) -> str:
    try:
        raw = path.read_bytes()
        manifest = strict_json(raw, fields=frozenset({"schema_version", "converter", "files"}))
    except OSError as exc:
        raise RuntimeError("converter manifest is unavailable") from exc
    if manifest.get("schema_version") != "v1" or manifest.get("converter") != APPROVED_CONVERTER:
        raise RuntimeError("converter manifest identity is invalid")
    files = manifest.get("files")
    if not isinstance(files, list) or not files:
        raise RuntimeError("converter manifest files are missing")
    roles: set[str] = set()
    paths: set[str] = set()
    for entry in files:
        if not isinstance(entry, dict) or set(entry) != {"role", "path", "sha256", "byte_size"}:
            raise RuntimeError("converter manifest file entry is invalid")
        role = entry.get("role")
        raw_path = entry.get("path")
        if not isinstance(raw_path, str):
            raise RuntimeError("converter manifest path is invalid")
        file_path = Path(raw_path)
        if (
            role not in REQUIRED_ROLES
            or not file_path.is_absolute()
            or file_path.as_posix() != raw_path
            or raw_path in paths
            or not is_sha256(entry.get("sha256"))
            or not positive_int(entry.get("byte_size"), 2**63 - 1)
        ):
            raise RuntimeError("converter manifest entry violates policy")
        try:
            metadata = file_path.lstat()
        except OSError as exc:
            raise RuntimeError("manifested converter material is missing") from exc
        if (
            file_path.is_symlink()
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink < 1
            or metadata.st_size != entry["byte_size"]
            or sha256_file(file_path) != entry["sha256"]
        ):
            raise RuntimeError("manifested converter bytes differ")
        roles.add(str(role))
        paths.add(raw_path)
    if not REQUIRED_ROLES.issubset(roles):
        raise RuntimeError("converter manifest material role is missing")
    return sha256_bytes(raw)


def _resource_preexec(
    limits: Mapping[str, int],
    *,
    uid: int | None = None,
    gid: int | None = None,
    child_umask: int = 0o077,
):
    def apply_limits() -> None:
        if resource is None:
            return
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        resource.setrlimit(resource.RLIMIT_CPU, (limits["cpu_seconds"], limits["cpu_seconds"]))
        resource.setrlimit(resource.RLIMIT_AS, (limits["address_space_bytes"], limits["address_space_bytes"]))
        resource.setrlimit(resource.RLIMIT_FSIZE, (limits["file_bytes"], limits["file_bytes"]))
        resource.setrlimit(resource.RLIMIT_NOFILE, (limits["open_files"], limits["open_files"]))
        if hasattr(resource, "RLIMIT_NPROC"):
            resource.setrlimit(resource.RLIMIT_NPROC, (limits["processes"], limits["processes"]))
        os.umask(child_umask)
        if uid is not None or gid is not None:
            os.setgroups([])
        if gid is not None:
            os.setgid(gid)
        if uid is not None:
            os.setuid(uid)

    return apply_limits


def _terminate_process(process: subprocess.Popen[bytes], *, process_group: bool) -> None:
    try:
        if process_group and os.name == "posix":
            os.killpg(process.pid, signal.SIGTERM)
        elif process.poll() is None:
            process.terminate()
    except ProcessLookupError:
        pass
    try:
        if process.poll() is None:
            process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass
    try:
        if process_group and os.name == "posix":
            os.killpg(process.pid, signal.SIGKILL)
        elif process.poll() is None:
            process.kill()
    except ProcessLookupError:
        pass
    if process.poll() is None:
        process.wait()


def _run_bounded(
    command: list[str],
    *,
    cwd: Path,
    environment: Mapping[str, str],
    timeout_seconds: int,
    limits: Mapping[str, int],
    process_group: bool,
    uid: int | None = None,
    gid: int | None = None,
    child_umask: int = 0o077,
    pass_fds: tuple[int, ...] = (),
) -> tuple[int, bytes, bytes]:
    process: subprocess.Popen[bytes] | None = None
    streams: list[bytearray] = [bytearray(), bytearray()]
    overflow = threading.Event()
    lock = threading.Lock()
    total = 0

    def drain(pipe: Any, target: bytearray) -> None:
        nonlocal total
        try:
            while True:
                chunk = os.read(pipe.fileno(), 64 * 1024)
                if not chunk:
                    return
                with lock:
                    if total + len(chunk) > limits["log_bytes"]:
                        overflow.set()
                        return
                    total += len(chunk)
                    target.extend(chunk)
        finally:
            pipe.close()

    try:
        process = subprocess.Popen(
            command,
            cwd=cwd,
            env=dict(environment),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            shell=False,
            start_new_session=process_group and os.name == "posix",
            preexec_fn=(
                _resource_preexec(limits, uid=uid, gid=gid, child_umask=child_umask)
                if os.name == "posix"
                else None
            ),
            close_fds=True,
            pass_fds=pass_fds if os.name == "posix" else (),
        )
        assert process.stdout is not None and process.stderr is not None
        threads = [
            threading.Thread(target=drain, args=(process.stdout, streams[0]), daemon=True),
            threading.Thread(target=drain, args=(process.stderr, streams[1]), daemon=True),
        ]
        for thread in threads:
            thread.start()
        deadline = time.monotonic() + timeout_seconds
        while process.poll() is None:
            if overflow.is_set():
                _terminate_process(process, process_group=process_group)
                raise SandboxResourceLimit("converter log limit exceeded")
            if time.monotonic() >= deadline:
                _terminate_process(process, process_group=process_group)
                raise SandboxResourceLimit("converter wall-clock limit exceeded")
            time.sleep(0.01)
        for thread in threads:
            thread.join(timeout=1)
        if overflow.is_set():
            raise SandboxResourceLimit("converter log limit exceeded")
        return process.returncode, bytes(streams[0]), bytes(streams[1])
    except OSError as exc:
        if exc.errno in {errno.EFBIG, errno.ENOMEM, errno.ENOSPC, errno.EMFILE, errno.ENFILE}:
            raise SandboxResourceLimit("converter process resource limit exceeded") from exc
        raise SandboxConverterFailure("converter process could not start") from exc
    finally:
        if process is not None and process_group:
            _terminate_process(process, process_group=True)


def _limits_from_environment(max_output_bytes: int, timeout_seconds: int) -> dict[str, int]:
    return {
        "cpu_seconds": min(timeout_seconds, int(os.environ.get("HWP_RLIMIT_CPU_SECONDS", timeout_seconds))),
        "address_space_bytes": int(os.environ.get("HWP_RLIMIT_AS_BYTES", str(512 * 1024 * 1024))),
        "file_bytes": min(max_output_bytes, int(os.environ.get("HWP_RLIMIT_FSIZE_BYTES", str(max_output_bytes)))),
        "open_files": int(os.environ.get("HWP_RLIMIT_NOFILE", "64")),
        "processes": int(os.environ.get("HWP_RLIMIT_NPROC", "32")),
        "log_bytes": int(os.environ.get("HWP_MAX_LOG_BYTES", str(1024 * 1024))),
    }


def _sanitized_environment(workspace: Path) -> dict[str, str]:
    return {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": str(workspace),
        "TMPDIR": str(workspace),
        "FONTCONFIG_FILE": "/etc/fonts/fonts.conf",
        "LC_ALL": "C.UTF-8",
        "TZ": "UTC",
        "NO_PROXY": "*",
        "http_proxy": "",
        "https_proxy": "",
        "ALL_PROXY": "",
    }


def _contains_warning(stdout: bytes, stderr: bytes) -> bool:
    lowered = stdout.lower() + b"\n" + stderr.lower()
    return bool(stderr) or any(token in lowered for token in WARNING_TOKENS)


def _was_resource_signal(return_code: int) -> bool:
    return return_code < 0 and -return_code in RESOURCE_SIGNALS


def _qpdf_page_count(
    output: Path,
    *,
    workspace: Path,
    environment: Mapping[str, str],
    timeout_seconds: int,
    limits: Mapping[str, int],
    uid: int | None = None,
    gid: int | None = None,
) -> int:
    descriptor: int | None = None
    target = str(output)
    pass_fds: tuple[int, ...] = ()
    if uid is not None:
        descriptor = os.open(
            output,
            os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        target = f"/proc/self/fd/{descriptor}"
        pass_fds = (descriptor,)
    try:
        check_code, check_stdout, check_stderr = _run_bounded(
            ["/usr/bin/qpdf", "--check", target],
            cwd=workspace,
            environment=environment,
            timeout_seconds=timeout_seconds,
            limits=limits,
            process_group=uid is not None,
            uid=uid,
            gid=gid,
            pass_fds=pass_fds,
        )
        if check_code != 0 or _contains_warning(check_stdout, check_stderr):
            raise SandboxConverterFailure("qpdf rejected the converted PDF")
        page_code, page_stdout, page_stderr = _run_bounded(
            ["/usr/bin/qpdf", "--show-npages", target],
            cwd=workspace,
            environment=environment,
            timeout_seconds=timeout_seconds,
            limits=limits,
            process_group=uid is not None,
            uid=uid,
            gid=gid,
            pass_fds=pass_fds,
        )
    finally:
        if descriptor is not None:
            os.close(descriptor)
    try:
        page_count = int(page_stdout.strip())
    except ValueError as exc:
        raise SandboxConverterFailure("qpdf returned an invalid page count") from exc
    if page_code != 0 or page_stderr or page_count < 1:
        raise SandboxConverterFailure("qpdf page count validation failed")
    return page_count


def _read_bounded_regular(path: Path, maximum: int) -> bytes:
    descriptor = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or not positive_int(metadata.st_size, maximum)
        ):
            raise SandboxConverterFailure("bounded child report is not a regular file")
        value = bytearray()
        while len(value) <= maximum:
            chunk = os.read(descriptor, min(64 * 1024, maximum + 1 - len(value)))
            if not chunk:
                break
            value.extend(chunk)
        if len(value) != metadata.st_size:
            raise SandboxResourceLimit("child report exceeds its byte limit")
        return bytes(value)
    finally:
        os.close(descriptor)


def run_exact_cli(arguments: argparse.Namespace) -> int:
    output = Path(arguments.output)
    report = Path(arguments.report)
    try:
        input_path = Path(arguments.input)
        if arguments.network != "none" or not input_path.is_absolute() or not output.is_absolute() or not report.is_absolute():
            raise SandboxInvalidInput("exact CLI requires network=none and absolute paths")
        if output.exists() or report.exists() or output.parent != report.parent:
            raise SandboxInvalidInput("output and report must be new files in one private directory")
        metadata = input_path.lstat()
        if input_path.is_symlink() or not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise SandboxInvalidInput("input must be a single-link regular file")
        with input_path.open("rb") as source:
            if source.read(len(HWP_SIGNATURE)) != HWP_SIGNATURE:
                raise SandboxInvalidInput("input does not have the HWP OLE signature")
        timeout_seconds = int(os.environ.get("HWP_JOB_TIMEOUT_SECONDS", "180"))
        max_output_bytes = int(os.environ.get("HWP_MAX_OUTPUT_BYTES", str(300 * 1024 * 1024)))
        max_pages = int(os.environ.get("HWP_MAX_PAGES", "2000"))
        limits = _limits_from_environment(max_output_bytes, timeout_seconds)
        environment = _sanitized_environment(output.parent)
        return_code, stdout, stderr = _run_bounded(
            ["/usr/local/bin/rhwp", "export-pdf", str(input_path), "-o", str(output)],
            cwd=output.parent,
            environment=environment,
            timeout_seconds=timeout_seconds,
            limits=limits,
            process_group=False,
        )
        if _was_resource_signal(return_code):
            raise SandboxResourceLimit("rhwp was terminated by a resource limit")
        if return_code != 0 or _contains_warning(stdout, stderr):
            raise SandboxConverterFailure("rhwp failed or emitted a warning/font fallback")
        output_metadata = output.lstat()
        with output.open("rb") as converted:
            pdf_prefix = converted.read(5)
        if (
            output.is_symlink()
            or not stat.S_ISREG(output_metadata.st_mode)
            or output_metadata.st_nlink != 1
            or not 0 < output_metadata.st_size <= max_output_bytes
            or pdf_prefix != b"%PDF-"
        ):
            raise SandboxConverterFailure("rhwp output is not a bounded regular PDF")
        page_count = _qpdf_page_count(
            output,
            workspace=output.parent,
            environment=environment,
            timeout_seconds=timeout_seconds,
            limits=limits,
        )
        if page_count > max_pages:
            raise SandboxResourceLimit("converted PDF page count exceeds policy")
        child_report = {
            "schema_version": "v1",
            "page_count": page_count,
            "pdf_mime": "application/pdf",
            "qpdf_validated": True,
            "warnings": [],
            "font_substitutions": [],
            "fallback_used": False,
        }
        report.write_bytes(canonical_json(child_report))
        return 0
    except SandboxInvalidInput:
        output.unlink(missing_ok=True)
        report.unlink(missing_ok=True)
        return EXIT_INVALID_INPUT
    except SandboxResourceLimit:
        output.unlink(missing_ok=True)
        report.unlink(missing_ok=True)
        return EXIT_RESOURCE_LIMIT
    except (SandboxConverterFailure, OSError, ValueError):
        output.unlink(missing_ok=True)
        report.unlink(missing_ok=True)
        return EXIT_CONVERTER_FAILURE


def _read_exact(connection: socket.socket, length: int) -> bytes:
    chunks: list[bytes] = []
    remaining = length
    while remaining:
        chunk = connection.recv(remaining)
        if not chunk:
            raise ProtocolViolation("peer disconnected during a framed request")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def _read_request(
    connection: socket.socket,
    server_limits: Mapping[str, int],
    *,
    magic: bytes | None = None,
) -> dict[str, Any]:
    if (magic if magic is not None else _read_exact(connection, len(PROTOCOL_MAGIC))) != PROTOCOL_MAGIC:
        raise ProtocolViolation("wrong request magic")
    length = struct.unpack("!I", _read_exact(connection, 4))[0]
    if not 0 < length <= MAX_HEADER_BYTES:
        raise ProtocolViolation("request header length is outside policy")
    request = strict_json(_read_exact(connection, length), fields=REQUEST_FIELDS)
    if request.get("schema_version") != "v1" or request.get("protocol_version") != PROTOCOL_VERSION:
        raise ProtocolViolation("request protocol is invalid")
    try:
        attempt_id = str(uuid.UUID(str(request.get("attempt_id"))))
    except (ValueError, AttributeError) as exc:
        raise ProtocolViolation("request attempt ID is invalid") from exc
    if attempt_id != request.get("attempt_id") or not positive_int(request.get("generation"), 2**31 - 1):
        raise ProtocolViolation("request identity is invalid")
    nonce = request.get("nonce")
    if not isinstance(nonce, str) or len(nonce) != 64 or any(c not in "0123456789abcdef" for c in nonce):
        raise ProtocolViolation("request nonce is invalid")
    if not is_sha256(request.get("converter_manifest_hash")):
        raise ProtocolViolation("request manifest hash is invalid")
    input_value = request.get("input")
    limits = request.get("limits")
    if not isinstance(input_value, dict) or set(input_value) != INPUT_FIELDS:
        raise ProtocolViolation("request input object is invalid")
    if not isinstance(limits, dict) or set(limits) != LIMIT_FIELDS:
        raise ProtocolViolation("request limit object is invalid")
    validate_relative_input(input_value.get("relative_path"))
    if not is_sha256(input_value.get("checksum_sha256")) or not positive_int(
        input_value.get("byte_size"), server_limits["max_input_bytes"]
    ):
        raise ProtocolViolation("request input material is invalid")
    for field in LIMIT_FIELDS:
        if not positive_int(limits.get(field), server_limits[field]):
            raise ProtocolViolation("request limit exceeds the sidecar policy")
    if connection.recv(1) != b"":
        raise ProtocolViolation("request contains trailing bytes")
    return request


def _process_probe(connection: socket.socket, manifest_hash: str) -> None:
    length = struct.unpack("!I", _read_exact(connection, 4))[0]
    if not 0 < length <= MAX_HEADER_BYTES:
        raise ProtocolViolation("probe header length is outside policy")
    request = strict_json(_read_exact(connection, length), fields=PROBE_FIELDS)
    nonce = request.get("nonce")
    if (
        request.get("schema_version") != "v1"
        or request.get("protocol_version") != PROTOCOL_VERSION
        or not isinstance(nonce, str)
        or len(nonce) != 64
        or any(character not in "0123456789abcdef" for character in nonce)
        or request.get("converter_manifest_hash") != manifest_hash
        or connection.recv(1) != b""
    ):
        raise ProtocolViolation("probe identity is invalid")
    response = canonical_json(
        {
            "schema_version": "v1",
            "protocol_version": PROTOCOL_VERSION,
            "nonce": nonce,
            "converter_manifest_hash": manifest_hash,
            "sandbox_policy": SANDBOX_POLICY,
            "ok": True,
        }
    )
    connection.sendall(PROBE_MAGIC)
    connection.sendall(struct.pack("!I", len(response)))
    connection.sendall(response)


def _send_response(
    connection: socket.socket,
    request: Mapping[str, Any],
    *,
    exit_code: int,
    report: bytes = b"",
    pdf_path: Path | None = None,
    pdf_size: int = 0,
) -> None:
    if exit_code != 0 and (report or pdf_path is not None or pdf_size):
        raise ProtocolViolation("failed response cannot contain partial material")
    if exit_code == 0 and (
        pdf_path is None
        or not positive_int(pdf_size, 512 * 1024 * 1024)
        or pdf_path.stat().st_size != pdf_size
    ):
        raise ProtocolViolation("successful response PDF identity is invalid")
    header = canonical_json(
        {
            "schema_version": "v1",
            "protocol_version": PROTOCOL_VERSION,
            "attempt_id": request["attempt_id"],
            "generation": request["generation"],
            "nonce": request["nonce"],
            "exit_code": exit_code,
            "report_bytes": len(report),
            "pdf_bytes": pdf_size,
        }
    )
    connection.sendall(PROTOCOL_MAGIC)
    connection.sendall(struct.pack("!I", len(header)))
    connection.sendall(header)
    if report:
        connection.sendall(report)
    if pdf_path is not None:
        with pdf_path.open("rb") as pdf:
            for chunk in iter(lambda: pdf.read(64 * 1024), b""):
                connection.sendall(chunk)


def _server_limits() -> dict[str, int]:
    return {
        "timeout_seconds": int(os.environ.get("HWP_JOB_TIMEOUT_SECONDS", "180")),
        "max_input_bytes": int(os.environ.get("HWP_MAX_INPUT_BYTES", str(128 * 1024 * 1024))),
        "max_output_bytes": int(os.environ.get("HWP_MAX_OUTPUT_BYTES", str(300 * 1024 * 1024))),
        "max_report_bytes": int(os.environ.get("HWP_MAX_REPORT_BYTES", str(64 * 1024))),
        "max_pages": int(os.environ.get("HWP_MAX_PAGES", "2000")),
    }


def _process_request(
    connection: socket.socket,
    *,
    request: dict[str, Any],
    input_root: Path,
    work_root: Path,
    manifest_hash: str,
    wrapper_path: Path,
) -> None:
    if request["converter_manifest_hash"] != manifest_hash:
        _send_response(connection, request, exit_code=EXIT_CONVERTER_FAILURE)
        return
    request_input = request["input"]
    limits = request["limits"]
    workspace = Path(tempfile.mkdtemp(prefix="job-", dir=work_root))
    try:
        child_uid = int(os.environ.get("HWP_CHILD_UID", "65533"))
        child_gid = int(os.environ.get("HWP_CHILD_GID", "65533"))
        validator_uid = int(os.environ.get("HWP_VALIDATOR_UID", "65534"))
        validator_gid = int(os.environ.get("HWP_VALIDATOR_GID", "65534"))
        if (
            os.name != "posix"
            or os.geteuid() in {0, child_uid, validator_uid}
            or len({os.geteuid(), child_uid, validator_uid}) != 3
            or min(child_uid, child_gid, validator_uid, validator_gid) < 1
        ):
            raise SandboxConverterFailure("sandbox process identities are not separated")
        workspace.chmod(0o711)
        untrusted = workspace / "untrusted"
        trusted = workspace / "trusted"
        validator_work = workspace / "validator"
        untrusted.mkdir(mode=0o770)
        trusted.mkdir(mode=0o700)
        validator_work.mkdir(mode=0o700)
        os.chown(untrusted, os.geteuid(), child_gid)
        os.chown(validator_work, validator_uid, validator_gid)
        # The supervisor owns the setgid directory, while the child group may create files.
        # A fresh trusted helper under the child identity later opens only the known output.
        untrusted.chmod(0o2770)
        trusted.chmod(0o700)
        validator_work.chmod(0o700)
        private_input = untrusted / "input.hwp"
        output = untrusted / "converted.pdf"
        child_report_path = untrusted / "child-report.json"
        trusted_output = trusted / "verified.pdf"
        snapshot_verified_input(
            input_root,
            request_input["relative_path"],
            request_input["byte_size"],
            request_input["checksum_sha256"],
            private_input,
        )
        private_input.chmod(0o400)
        os.chown(private_input, child_uid, child_gid)
        environment = _sanitized_environment(untrusted)
        environment.update(
            {
                "HWP_JOB_TIMEOUT_SECONDS": str(limits["timeout_seconds"]),
                "HWP_MAX_OUTPUT_BYTES": str(limits["max_output_bytes"]),
                "HWP_MAX_PAGES": str(limits["max_pages"]),
                "HWP_RLIMIT_CPU_SECONDS": str(limits["timeout_seconds"]),
                "HWP_RLIMIT_FSIZE_BYTES": str(limits["max_output_bytes"]),
            }
        )
        process_limits = _limits_from_environment(limits["max_output_bytes"], limits["timeout_seconds"])
        exit_code, stdout, stderr = _run_bounded(
            [
                str(wrapper_path),
                "--network=none",
                "--input",
                str(private_input),
                "--output",
                str(output),
                "--report",
                str(child_report_path),
            ],
            cwd=untrusted,
            environment=environment,
            timeout_seconds=limits["timeout_seconds"],
            limits=process_limits,
            process_group=True,
            uid=child_uid,
            gid=child_gid,
            child_umask=0o027,
        )
        if _was_resource_signal(exit_code):
            _send_response(connection, request, exit_code=EXIT_RESOURCE_LIMIT)
            return
        if exit_code in {EXIT_INVALID_INPUT, EXIT_CONVERTER_FAILURE, EXIT_RESOURCE_LIMIT}:
            _send_response(connection, request, exit_code=exit_code)
            return
        if exit_code != 0 or _contains_warning(stdout, stderr):
            _send_response(connection, request, exit_code=EXIT_CONVERTER_FAILURE)
            return
        child_report_raw = _read_bounded_regular(child_report_path, limits["max_report_bytes"])
        child_report = strict_json(child_report_raw, fields=CHILD_REPORT_FIELDS)
        if (
            child_report.get("schema_version") != "v1"
            or child_report.get("pdf_mime") != "application/pdf"
            or child_report.get("qpdf_validated") is not True
            or child_report.get("warnings") != []
            or child_report.get("font_substitutions") != []
            or child_report.get("fallback_used") is not False
            or not positive_int(child_report.get("page_count"), limits["max_pages"])
        ):
            raise SandboxConverterFailure("child conversion report is invalid")
        snapshot = snapshot_via_identity(
            output,
            trusted_output,
            wrapper_path=wrapper_path,
            workspace=untrusted,
            environment=environment,
            timeout_seconds=limits["timeout_seconds"],
            limits=process_limits,
            max_output_bytes=limits["max_output_bytes"],
            uid=child_uid,
            gid=child_gid,
        )
        validator_environment = _sanitized_environment(validator_work)
        verified_page_count = _qpdf_page_count(
            trusted_output,
            workspace=validator_work,
            environment=validator_environment,
            timeout_seconds=limits["timeout_seconds"],
            limits=process_limits,
            uid=validator_uid,
            gid=validator_gid,
        )
        if verified_page_count != child_report["page_count"]:
            raise SandboxConverterFailure("supervisor qpdf page count differs from child report")
        final_report = canonical_json(
            {
                "schema_version": "v1",
                "protocol_version": PROTOCOL_VERSION,
                "attempt_id": request["attempt_id"],
                "generation": request["generation"],
                "nonce": request["nonce"],
                "input_checksum_sha256": request_input["checksum_sha256"],
                "input_byte_size": request_input["byte_size"],
                "output_pdf_checksum_sha256": snapshot["sha256"],
                "output_pdf_byte_size": snapshot["byte_size"],
                "page_count": verified_page_count,
                "pdf_mime": "application/pdf",
                "qpdf_validated": True,
                "converter_manifest_hash": manifest_hash,
                "sandbox_policy": SANDBOX_POLICY,
                "warnings": [],
                "font_substitutions": [],
                "fallback_used": False,
                "partial_text_used": False,
                "stdout_evidence_used": False,
            }
        )
        if len(final_report) > limits["max_report_bytes"]:
            raise SandboxResourceLimit("final report exceeds its byte limit")
        _send_response(
            connection,
            request,
            exit_code=0,
            report=final_report,
            pdf_path=trusted_output,
            pdf_size=snapshot["byte_size"],
        )
    except SandboxInvalidInput:
        _send_response(connection, request, exit_code=EXIT_INVALID_INPUT)
    except SandboxResourceLimit:
        _send_response(connection, request, exit_code=EXIT_RESOURCE_LIMIT)
    except (SandboxConverterFailure, ProtocolViolation, OSError, ValueError, KeyError):
        _send_response(connection, request, exit_code=EXIT_CONVERTER_FAILURE)
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def run_server(arguments: argparse.Namespace) -> int:
    socket_path = Path(arguments.socket)
    input_root = Path(arguments.input_root)
    work_root = Path(arguments.work_root)
    manifest_path = Path(arguments.manifest)
    wrapper_path = Path(__file__).resolve()
    if os.geteuid() == 0:
        raise RuntimeError("HWP sandbox refuses to run as root")
    if not socket_path.is_absolute() or not input_root.is_absolute() or not work_root.is_absolute():
        raise RuntimeError("sandbox roots must be absolute")
    if input_root.is_symlink() or not input_root.is_dir() or work_root.is_symlink() or not work_root.is_dir():
        raise RuntimeError("sandbox roots are missing or unsafe")
    for root in (socket_path.parent, input_root, work_root):
        metadata = root.lstat()
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_gid != os.getegid()
            or stat.S_IMODE(metadata.st_mode) & 0o077
        ):
            raise RuntimeError("sandbox root is not supervisor-only")
    manifest_hash = verify_manifest(manifest_path)
    if socket_path.exists() or socket_path.is_symlink():
        metadata = socket_path.lstat()
        if socket_path.is_symlink() or not stat.S_ISSOCK(metadata.st_mode):
            raise RuntimeError("refusing to replace a non-socket control path")
        socket_path.unlink()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(str(socket_path))
        socket_path.chmod(0o600)
        server.listen(8)
        while True:
            connection, _ = server.accept()
            with connection:
                connection.settimeout(_server_limits()["timeout_seconds"] + 10)
                try:
                    magic = _read_exact(connection, len(PROTOCOL_MAGIC))
                    if magic == PROBE_MAGIC:
                        _process_probe(connection, manifest_hash)
                    else:
                        request = _read_request(connection, _server_limits(), magic=magic)
                        _process_request(
                            connection,
                            request=request,
                            input_root=input_root,
                            work_root=work_root,
                            manifest_hash=manifest_hash,
                            wrapper_path=wrapper_path,
                        )
                except (ProtocolViolation, SandboxInvalidInput, OSError):
                    continue
    finally:
        server.close()
        socket_path.unlink(missing_ok=True)


def run_probe(arguments: argparse.Namespace) -> int:
    path = Path(arguments.socket)
    if not hasattr(socket, "AF_UNIX") or not path.is_socket():
        return 1
    try:
        manifest_hash = verify_manifest(Path(arguments.manifest))
        nonce = hashlib.sha256(f"{os.getpid()}:{time.monotonic_ns()}".encode()).hexdigest()
        request = canonical_json(
            {
                "schema_version": "v1",
                "protocol_version": PROTOCOL_VERSION,
                "nonce": nonce,
                "converter_manifest_hash": manifest_hash,
            }
        )
        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        connection.settimeout(2)
        with connection:
            connection.connect(str(path))
            connection.sendall(PROBE_MAGIC + struct.pack("!I", len(request)) + request)
            connection.shutdown(socket.SHUT_WR)
            if _read_exact(connection, len(PROBE_MAGIC)) != PROBE_MAGIC:
                return 1
            length = struct.unpack("!I", _read_exact(connection, 4))[0]
            if not 0 < length <= MAX_HEADER_BYTES:
                return 1
            response = strict_json(_read_exact(connection, length), fields=frozenset({
                "schema_version", "protocol_version", "nonce", "converter_manifest_hash", "sandbox_policy", "ok"
            }))
            if (
                response.get("schema_version") != "v1"
                or response.get("protocol_version") != PROTOCOL_VERSION
                or response.get("nonce") != nonce
                or response.get("converter_manifest_hash") != manifest_hash
                or response.get("sandbox_policy") != SANDBOX_POLICY
                or response.get("ok") is not True
                or connection.recv(1) != b""
            ):
                return 1
    except (OSError, RuntimeError, ProtocolViolation):
        return 1
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "serve":
        parser = argparse.ArgumentParser()
        parser.add_argument("serve")
        parser.add_argument("--socket", required=True)
        parser.add_argument("--input-root", required=True)
        parser.add_argument("--work-root", required=True)
        parser.add_argument("--manifest", required=True)
        return run_server(parser.parse_args(argv))
    if argv and argv[0] == "probe":
        parser = argparse.ArgumentParser()
        parser.add_argument("probe")
        parser.add_argument("--socket", required=True)
        parser.add_argument("--manifest", required=True)
        return run_probe(parser.parse_args(argv))
    if argv and argv[0] == "snapshot":
        parser = argparse.ArgumentParser()
        parser.add_argument("snapshot")
        parser.add_argument("--source", required=True)
        parser.add_argument("--destination-fd", required=True)
        parser.add_argument("--max-output-bytes", required=True)
        return run_snapshot_cli(parser.parse_args(argv))
    parser = argparse.ArgumentParser()
    parser.add_argument("--network", required=True)
    parser.add_argument("--input", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--report", required=True)
    return run_exact_cli(parser.parse_args(argv))


if __name__ == "__main__":
    raise SystemExit(main())
